---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  image: ImageMetadata;
  alt: string;
  loading?: 'eager' | 'lazy';
}

const { image, alt, loading = 'lazy' } = Astro.props;
---

<div class="ipad-frame">
  <Picture
    src={image}
    alt={alt}
    formats={['avif', 'webp']}
    widths={[480, 960, 1920]}
    sizes="(max-width: 720px) calc(100vw - 58px), (max-width: 1024px) calc(100vw - 82px), 942px"
    loading={loading}
  />
</div>

<style>
  .ipad-frame {
    padding: var(--sp-2);
    border: 1px solid var(--border-default);
    border-radius: 28px;
    background: var(--n-000);
  }

  .ipad-frame :global(img) {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 20px;
    outline: 1px solid oklch(1 0 0 / 0.1);
  }
</style>
