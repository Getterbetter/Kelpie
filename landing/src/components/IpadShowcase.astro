---
import { ipadScreens } from '../data/ipad-screens';
import IpadScreenshot from './IpadScreenshot.astro';

const screen = ipadScreens[0];
---

<section id="ipad" class="ipad-showcase" aria-labelledby="ipad-heading">
  <div class="eyebrow">Heeler on iPad</div>
  <h2 id="ipad-heading">Fits your workspace.</h2>
  <p>{screen.caption}</p>
  <a class="screenshot-link" href="/ipad" aria-label="View all iPad screenshots">
    <IpadScreenshot image={screen.image} alt={screen.alt} />
  </a>
  <a class="more-link text-link" href="/ipad">
    View all iPad screenshots <span aria-hidden="true">&rarr;</span>
  </a>
</section>

<style>
  .ipad-showcase {
    max-width: 960px;
    margin: 80px auto 0;
    scroll-margin-top: 96px;
  }

  h2 {
    font: var(--type-h2);
    letter-spacing: var(--tr-heading);
    margin-top: var(--sp-3);
  }

  p {
    font: var(--type-body);
    color: var(--text-secondary);
    margin-top: var(--sp-3);
  }

  .screenshot-link {
    display: block;
    margin-top: var(--sp-8);
    border-radius: 28px;
  }

  .screenshot-link:hover,
  .screenshot-link:focus-visible {
    outline: 2px solid var(--text-secondary);
    outline-offset: 4px;
  }

  .more-link {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-2);
    min-height: 44px;
    margin-top: var(--sp-4);
    font: var(--type-label);
  }

  @media (max-width: 720px) {
    .ipad-showcase {
      margin-top: 56px;
    }
  }
</style>
